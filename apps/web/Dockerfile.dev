# =============================================================================
# Taskify Frontend - Development Dockerfile
# =============================================================================
# Runs the Vite dev server with hot module reload for local development via
# docker-compose. Source is bind-mounted from the host.
# =============================================================================

FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
RUN npm install
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
